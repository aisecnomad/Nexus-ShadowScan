__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
.eggs/
/build/
/dist/
*.whl
.venv/
venv/
# Scratch input the requirements-docs.lock refresh recipe writes at the root;
# root-anchored so a fixture or source file of that name is never hidden.
/requirements-docs.in
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
.tox/
.nox/
*.sarif
# Root-level scan and site output; unanchored, these would also hide source
# files such as shadowscan/reporters/report.py.
/report.*
/shadowscan-report*
/exports/
.env
.env.*
!.env.example
*.pem
*.key
# Other local credential stores an operator may keep next to a checkout. No
# fixture uses these names; force-add one deliberately if a test ever needs it.
*.p12
*.pfx
.envrc
.direnv/
.netrc
.pypirc
*.tfstate
*.tfstate.*
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
node_modules/

.shadowscan-state/
# Worktrees that coding-agent sessions create inside the checkout.
/.claude/worktrees/
/site/
