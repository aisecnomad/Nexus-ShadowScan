{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "eta-vllm-serving", "namespace": "ml"},
      "spec": {
        "template": {
          "spec": {
            "containers": [
              {
                "name": "server",
                "image": "registry.vantor.example/ml/vllm-serving:0.6.3",
                "args": ["--model", "Qwen/Qwen2.5-7B-Instruct", "--port", "8000"],
                "env": [{"name": "HF_HOME", "value": "/models"}],
                "resources": {"limits": {"nvidia.com/gpu": "1"}}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "sagemaker-billing-exporter", "namespace": "finops"},
      "spec": {
        "template": {
          "spec": {
            "containers": [
              {"name": "exporter", "image": "python:3.12-slim", "args": ["--billing-export"]}
            ]
          }
        }
      }
    }
  ]
}
