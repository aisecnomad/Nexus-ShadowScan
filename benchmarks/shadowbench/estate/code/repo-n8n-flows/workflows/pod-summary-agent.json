{
  "name": "POD summary agent",
  "nodes": [
    {
      "parameters": {
        "mailbox": "pod-inbox",
        "postProcessAction": "read",
        "options": {}
      },
      "id": "n1",
      "name": "POD inbox",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [0, 0],
      "credentials": {
        "imap": {
          "id": "7",
          "name": "pod shared mailbox"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.textPlain }}",
        "options": {
          "systemMessage": "Summarise the proof-of-delivery email for the dispatch log: consignee, delivery time, exceptions. One line per shipment."
        }
      },
      "id": "n2",
      "name": "Summary agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [220, 0]
    },
    {
      "parameters": {
        "model": "claude-3-5-haiku-20241022",
        "options": {
          "maxTokensToSample": 400
        }
      },
      "id": "n3",
      "name": "Anthropic chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [200, 190],
      "credentials": {
        "anthropicApi": {
          "id": "9",
          "name": "Anthropic ops key"
        }
      }
    },
    {
      "parameters": {
        "channel": "#dispatch-log",
        "text": "={{ $json.output }}"
      },
      "id": "n4",
      "name": "Post to dispatch log",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [460, 0],
      "credentials": {
        "slackApi": {
          "id": "5",
          "name": "dispatch bot"
        }
      }
    }
  ],
  "connections": {
    "POD inbox": {
      "main": [[{ "node": "Summary agent", "type": "main", "index": 0 }]]
    },
    "Anthropic chat model": {
      "ai_languageModel": [[{ "node": "Summary agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Summary agent": {
      "main": [[{ "node": "Post to dispatch log", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Warsaw"
  },
  "tags": [{ "name": "freight-desk" }]
}
