{
  "name": "Carrier rate sheet sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 6 }]
        }
      },
      "id": "n1",
      "name": "Every six hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://rates.carrierportal.example/v1/sheets/vantor",
        "options": {
          "timeout": 20000
        }
      },
      "id": "n2",
      "name": "Fetch rate sheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": "freight",
        "table": "carrier_rates",
        "columns": "carrier,lane,rate,valid_until"
      },
      "id": "n3",
      "name": "Upsert rates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 0],
      "credentials": {
        "postgres": {
          "id": "3",
          "name": "freight warehouse"
        }
      }
    }
  ],
  "connections": {
    "Every six hours": {
      "main": [[{ "node": "Fetch rate sheet", "type": "main", "index": 0 }]]
    },
    "Fetch rate sheet": {
      "main": [[{ "node": "Upsert rates", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Warsaw"
  },
  "tags": [{ "name": "freight-desk" }]
}
